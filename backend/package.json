{
    "name": "backend",
    "version": "1.0.0",
    "description": "Cryptopets backend: Web3 auth, dialogue LLM, and gRPC/GraphQL game-data APIs",
    "license": "SEE LICENSE IN ../LICENSE",
    "main": "dist/src/server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "pnpm clean && prisma generate && tsc && node scripts/copy-proto.cjs && node scripts/bundle-shared-node.cjs && node scripts/bundle-protocol.cjs",
        "build:vercel": "pnpm build && node scripts/bundle-vercel.cjs",
        "start": "node dist/src/server.js",
        "dev": "nodemon",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "postinstall": "prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:status": "prisma migrate status",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "db:push": "prisma db push",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
        "lint": "eslint . && pnpm typecheck:scripts",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@ai-sdk/openai": "^3.0.68",
        "@aws-sdk/client-kms": "^3.1107.0",
        "@coral-xyz/anchor": "^0.32.0",
        "@cryptopets/protocol": "workspace:*",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "@noble/curves": "^1.9.7",
        "@noble/hashes": "^1.8.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@shared/core": "workspace:*",
        "@solana/web3.js": "^1.95.0",
        "@switchboard-xyz/on-demand": "^3.10.2",
        "@vercel/functions": "3.10.2",
        "ai": "^6.0.197",
        "bs58": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "ethers": "^6.8.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "graphql": "^16.11.0",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "pg": "^8.21.0",
        "tweetnacl": "^1.0.3",
        "viem": "^2.0.0",
        "ws": "^8.18.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^22.18.6",
        "@types/pg": "^8.20.0",
        "@types/ws": "^8.5.13",
        "@vitest/coverage-v8": "^4.1.8",
        "esbuild": "^0.25.0",
        "eslint": "^9.36.0",
        "globals": "^16.4.0",
        "nodemon": "^3.1.10",
        "prisma": "^7.8.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.44.0",
        "vitest": "^4.1.8"
    }
}
